# RSS feed to build the episode pages from. Either an http(s) URL or a local
# file path (relative to the project root, or absolute) for offline builds.
PODCAST_RSS_URL=https://media.rss.com/tales-beneath-the-surface/feed.xml

# Public URL of the deployed site, no trailing path. MUST be set before deploying,
# otherwise canonical URLs, Open Graph URLs and the sitemap will point at the placeholder.
SITE_URL=https://example.com

# Set to "false" to skip Astro's optimisation of remote cover images (e.g. when
# building offline from a local feed file). Defaults to true.
OPTIMIZE_REMOTE_IMAGES=true
